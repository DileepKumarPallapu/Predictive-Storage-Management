# AEGISSTOR Environment Configuration Example

# Operating Mode: 'demo' | 'replay' | 'live'
AEGISSTOR_MODE=demo

# Database URL (SQLite for local standalone, or PostgreSQL for enterprise scale)
# DATABASE_URL=postgresql://user:password@localhost:5432/aegisstor
DATABASE_URL=sqlite:///./aegisstor.db

# Hard Safety & Shadow Mode Configuration
SHADOW_MODE_ENABLED=true

# Security Secrets (REQUIRED in production; set a 32+ char cryptographic random string)
SECRET_KEY=replace-with-a-secure-random-token-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First-run Administrator Bootstrap (optional; or complete via /setup UI/POST /api/v1/auth/setup)
# AEGISSTOR_BOOTSTRAP_ADMIN_USERNAME=
# AEGISSTOR_BOOTSTRAP_ADMIN_EMAIL=
# AEGISSTOR_BOOTSTRAP_ADMIN_PASSWORD=

# Development synthetic user seeding (NEVER set true in production)
AEGISSTOR_ALLOW_DEV_SEED=false

# Cookie security flags (set AEGISSTOR_COOKIE_SECURE=true over HTTPS in production)
AEGISSTOR_COOKIE_SECURE=false
AEGISSTOR_COOKIE_SAMESITE=lax

# Telemetry & Sampling
TELEMETRY_SAMPLING_MINUTES=60
DEFAULT_FORECAST_HORIZON_HOURS=72
NOMINAL_COVERAGE=0.80
