# AEGISSTOR Environment Configuration Example

# Operating Mode: 'demo' | 'replay' | 'live'
AEGISSTOR_MODE=demo

# Database URL (SQLite for local standalone, or PostgreSQL for enterprise scale)
# DATABASE_URL=postgresql://user:password@localhost:5432/aegisstor
DATABASE_URL=sqlite:///./aegisstor.db

# Hard Safety & Shadow Mode Configuration
SHADOW_MODE_ENABLED=true

# Security Secrets
SECRET_KEY=replace-with-a-secure-random-token-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telemetry & Sampling
TELEMETRY_SAMPLING_MINUTES=60
DEFAULT_FORECAST_HORIZON_HOURS=72
NOMINAL_COVERAGE=0.80

# Live enterprise connector sync worker (run separately from the API process)
AEGISSTOR_CONNECTOR_SYNC_INTERVAL_SECONDS=300
# Example secret references must be supplied as platform environment secrets:
# AEGISSTOR_CONNECTOR_HOSPITAL_PG_URL=postgresql+psycopg://readonly_user:...@db-host:5432/hospital
# AEGISSTOR_CONNECTOR_COLLEGE_MYSQL_URL=mysql+pymysql://readonly_user:...@db-host:3306/college
# Never commit actual database connection URLs or credentials to Git.
