# AEGISSTOR — Production Environment Template (Never commit real values)
ENVIRONMENT=production
AEGISSTOR_MODE=live
AEGISSTOR_ALLOW_DEV_SEED=false
DATABASE_URL=postgresql://aegisstor_prod:<PROD_DB_PASSWORD>@<PROD_PG_HOST>:5432/aegisstor_prod
DB_SSL_MODE=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
REDIS_URL=rediss://<PROD_REDIS_HOST>:6379/0
SECRET_KEY=<GENERATE_64_CHAR_PRODUCTION_SECRET>
ACCESS_TOKEN_EXPIRE_MINUTES=480
SHADOW_MODE_ENABLED=true
AEGISSTOR_COOKIE_SECURE=true
AEGISSTOR_COOKIE_SAMESITE=none
CORS_ALLOWED_ORIGINS=https://aegisstor.vercel.app
OBJECT_STORAGE_BUCKET=aegisstor-prod-artifacts
OBJECT_STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=<PROD_S3_ACCESS_KEY>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<PROD_S3_SECRET_KEY>
OBJECT_STORAGE_PREFIX=production
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TLS_VERIFY=true
