# AEGISSTOR — Local Development Environment Template
ENVIRONMENT=local
AEGISSTOR_MODE=demo
AEGISSTOR_ALLOW_DEV_SEED=true
DATABASE_URL=sqlite:///./aegisstor.db
SECRET_KEY=local-dev-only-secret-key-change-before-deploying-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SHADOW_MODE_ENABLED=true
AEGISSTOR_COOKIE_SECURE=false
AEGISSTOR_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REDIS_URL=
OBJECT_STORAGE_BUCKET=
PROMETHEUS_URL=
