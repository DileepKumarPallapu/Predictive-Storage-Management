# AEGISSTOR — Staging Environment Template (Never mix with production)
ENVIRONMENT=staging
AEGISSTOR_MODE=live
AEGISSTOR_ALLOW_DEV_SEED=false
DATABASE_URL=postgresql://aegisstor_staging:<STAGING_DB_PASSWORD>@<STAGING_PG_HOST>:5432/aegisstor_staging
DB_SSL_MODE=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=rediss://<STAGING_REDIS_HOST>:6379/0
SECRET_KEY=<GENERATE_64_CHAR_STAGING_SECRET>
ACCESS_TOKEN_EXPIRE_MINUTES=480
SHADOW_MODE_ENABLED=true
AEGISSTOR_COOKIE_SECURE=true
AEGISSTOR_COOKIE_SAMESITE=none
CORS_ALLOWED_ORIGINS=https://staging-aegisstor.vercel.app
OBJECT_STORAGE_BUCKET=aegisstor-staging-artifacts
OBJECT_STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=<STAGING_S3_ACCESS_KEY>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<STAGING_S3_SECRET_KEY>
OBJECT_STORAGE_PREFIX=staging
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TLS_VERIFY=true
